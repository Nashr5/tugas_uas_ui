# Konfigurasi Database MySQL
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app_secret
MYSQL_ROOT_PASSWORD=root_secret

# Konfigurasi Google Authenticator / TOTP
# (Jika GOOGLE2FA_SECRET dikosongkan, secret dibuat & disimpan otomatis secara persisten)
# GOOGLE2FA_SECRET=
GOOGLE2FA_ACCOUNT=admin@belikita.com
GOOGLE2FA_ISSUER='Belikita'

# Konfigurasi SMTP Email (Pengiriman OTP Lupa Kata Sandi)
# Contoh jika menggunakan Gmail (Gunakan App Password Google):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=emailanda@gmail.com
# SMTP_PASSWORD=password_aplikasi_16_karakter
# SMTP_ENCRYPTION=tls
# SMTP_FROM_EMAIL=emailanda@gmail.com
# SMTP_FROM_NAME='Belikita Support'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=no-reply@belikita.com
SMTP_FROM_NAME='Belikita'
